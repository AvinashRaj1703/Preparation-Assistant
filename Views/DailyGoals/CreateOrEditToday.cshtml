@model SmartStudyPlanner.Models.DailyGoal
@{
    ViewData["Title"] = "Set Today's Study Goal";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card card-custom p-4 shadow-sm">
            <h4 class="fw-bold mb-3"><i class="bi bi-bullseye text-primary me-2"></i>Set Today's Study Targets</h4>
            <p class="text-secondary small mb-4">Set realistic goals for today (@DateTime.Today.ToString("dddd, MMM dd")). The system will automatically calculate your progress as you log study sessions and complete tasks.</p>

            <form asp-action="CreateOrEditToday" method="post">
                <input type="hidden" asp-for="GoalId" />
                <input type="hidden" asp-for="UserId" />
                <input type="hidden" asp-for="GoalDate" />

                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="TargetStudyMinutes" class="form-label fw-semibold">Target Study Time (Minutes)</label>
                    <div class="input-group">
                        <input asp-for="TargetStudyMinutes" type="number" min="15" max="720" step="15" class="form-control" />
                        <span class="input-group-text">minutes</span>
                    </div>
                    <small class="text-muted">e.g. 120 mins = 2 hours, 180 mins = 3 hours</small>
                    <span asp-validation-for="TargetStudyMinutes" class="text-danger small d-block"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="TargetTasks" class="form-label fw-semibold">Target Tasks to Complete</label>
                    <div class="input-group">
                        <input asp-for="TargetTasks" type="number" min="1" max="20" class="form-control" />
                        <span class="input-group-text">tasks</span>
                    </div>
                    <span asp-validation-for="TargetTasks" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Notes" class="form-label fw-semibold">Focus Notes / Affirmation</label>
                    <textarea asp-for="Notes" class="form-control" rows="3" placeholder="e.g. Complete ASP.NET Core project and solve 2 BST problems"></textarea>
                    <span asp-validation-for="Notes" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary-custom">Save Daily Goal</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

