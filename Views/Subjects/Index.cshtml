@model IEnumerable<SmartStudyPlanner.Models.Subject>
@{
    ViewData["Title"] = "Subject Management";
}

<div class="page-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
    <div>
        <h2><i class="bi bi-journal-bookmark-fill text-primary me-2"></i>Subject Management</h2>
        <p class="text-secondary mb-0">Organize your academic courses, syllabus, and study resources.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary-custom">
        <i class="bi bi-plus-lg me-1"></i> Add New Subject
    </a>
</div>

<div class="row g-4">
    @if (Model.Any())
    {
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card card-custom h-100 p-4 position-relative">
                    <div class="d-flex align-items-start justify-content-between mb-3">
                        <div class="stat-icon-box bg-primary-subtle text-primary">
                            <i class="bi bi-book-half"></i>
                        </div>
                        <span class="badge @(item.IsActive ? "bg-success-subtle text-success border border-success-subtle" : "bg-secondary-subtle text-secondary") rounded-pill">
                            @(item.IsActive ? "Active" : "Archived")
                        </span>
                    </div>

                    <h5 class="fw-bold mb-2">@item.SubjectName</h5>

                    <div class="row g-2 mb-3 text-center small text-muted">
                        <div class="col-4">
                            <div class="p-2 bg-light rounded-2 border">
                                <span class="fw-bold text-dark d-block">@item.Tasks.Count</span>
                                <span>Tasks</span>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-2 bg-light rounded-2 border">
                                <span class="fw-bold text-dark d-block">@item.Exams.Count</span>
                                <span>Exams</span>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-2 bg-light rounded-2 border">
                                <span class="fw-bold text-dark d-block">@(Math.Round((double)item.StudySessions.Sum(s => s.DurationMinutes) / 60.0, 1))h</span>
                                <span>Studied</span>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-auto pt-3 border-top">
                        <a asp-controller="Tasks" asp-action="Index" asp-route-subjectId="@item.SubjectId" class="btn btn-sm btn-outline-primary flex-fill">
                            <i class="bi bi-list-check me-1"></i> Tasks
                        </a>
                        <a asp-action="Edit" asp-route-id="@item.SubjectId" class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <form asp-action="Delete" asp-route-id="@item.SubjectId" method="post" onsubmit="return confirm('Delete this subject and all its related tasks/exams?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <div class="card card-custom p-5 text-center text-muted">
                <i class="bi bi-journal-plus fs-1 text-primary mb-3"></i>
                <h4>No Subjects Enrolled Yet</h4>
                <p>Add your college courses, topics, or exam subjects to get organized.</p>
                <div>
                    <a asp-action="Create" class="btn btn-primary-custom">Add Your First Subject</a>
                </div>
            </div>
        </div>
    }
</div>

