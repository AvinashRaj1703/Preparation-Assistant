@model SmartStudyPlanner.Models.StudySession
@{
    ViewData["Title"] = "Log Study Session";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card card-custom p-4 shadow-sm">
            <h4 class="fw-bold mb-3"><i class="bi bi-play-circle text-primary me-2"></i>Log Study Session</h4>

            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="SubjectId" class="form-label fw-semibold"></label>
                        <select asp-for="SubjectId" class="form-select" asp-items="ViewBag.SubjectId">
                            <option value="">-- Select Subject --</option>
                        </select>
                        <span asp-validation-for="SubjectId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="TaskId" class="form-label fw-semibold"></label>
                        <select asp-for="TaskId" class="form-select" asp-items="ViewBag.TaskId">
                            <option value="">-- None (General Study) --</option>
                        </select>
                        <span asp-validation-for="TaskId" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Topic" class="form-label fw-semibold"></label>
                        <input asp-for="Topic" class="form-control" placeholder="e.g. EF Core Migrations, QuickSort analysis, Chapter 3 notes" />
                        <span asp-validation-for="Topic" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="StudyDate" class="form-label fw-semibold"></label>
                        <input asp-for="StudyDate" type="date" class="form-control" />
                        <span asp-validation-for="StudyDate" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="StartTime" class="form-label fw-semibold"></label>
                        <input asp-for="StartTime" type="time" class="form-control" />
                        <span asp-validation-for="StartTime" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="EndTime" class="form-label fw-semibold"></label>
                        <input asp-for="EndTime" type="time" class="form-control" />
                        <span asp-validation-for="EndTime" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="DurationMinutes" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <input asp-for="DurationMinutes" type="number" min="5" max="720" step="5" class="form-control" />
                            <span class="input-group-text">minutes</span>
                        </div>
                        <span asp-validation-for="DurationMinutes" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Status" class="form-label fw-semibold"></label>
                        <select asp-for="Status" class="form-select">
                            <option value="Completed" selected>Completed</option>
                            <option value="In Progress">In Progress</option>
                            <option value="Planned">Planned</option>
                        </select>
                        <span asp-validation-for="Status" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Notes" class="form-label fw-semibold"></label>
                        <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Key takeaways, formulas, doubts to review, or code snippets..."></textarea>
                        <span asp-validation-for="Notes" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-between mt-4 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary-custom">Save Study Log</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

