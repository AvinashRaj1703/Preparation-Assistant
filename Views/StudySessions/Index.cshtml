@model IEnumerable<SmartStudyPlanner.Models.StudySession>
@{
    ViewData["Title"] = "Study Sessions";
}

<div class="page-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
    <div>
        <h2><i class="bi bi-clock-history text-primary me-2"></i>Study Sessions Log</h2>
        <p class="text-secondary mb-0">Record your daily focused study blocks, durations, and session notes.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary-custom">
        <i class="bi bi-plus-lg me-1"></i> Log Study Session
    </a>
</div>

<!-- Summary & Filter Bar -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card card-custom p-3 bg-primary text-white h-100">
            <small class="text-white-50 text-uppercase fw-semibold">Total Time Studied</small>
            <h2 class="fw-bold mb-0 mt-1">@ViewBag.TotalHours <span class="fs-6 fw-normal">Hours</span></h2>
            <small class="text-white-50">@ViewBag.TotalLoggedMinutes total minutes across all subjects</small>
        </div>
    </div>
    <div class="col-md-8">
        <div class="card card-custom p-3 h-100 d-flex justify-content-center">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-sm-8">
                    <select name="subjectId" class="form-select" asp-items="ViewBag.Subjects" onchange="this.form.submit()">
                        <option value="">-- All Enrolled Subjects --</option>
                    </select>
                </div>
                <div class="col-sm-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100">Filter</button>
                    @if (ViewBag.SelectedSubjectId != null)
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
                    }
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Sessions Table -->
<div class="card card-custom overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small text-uppercase text-secondary">
                <tr>
                    <th>Study Date</th>
                    <th>Topic / Content</th>
                    <th>Subject</th>
                    <th>Related Task</th>
                    <th>Time Slot</th>
                    <th>Duration</th>
                    <th>Status</th>
                    <th>Notes</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td>
                                <strong>@s.StudyDate.ToString("MMM dd, yyyy")</strong>
                                <small class="text-muted d-block">@s.StudyDate.ToString("dddd")</small>
                            </td>
                            <td class="fw-bold">@s.Topic</td>
                            <td>
                                <span class="badge bg-light text-primary border">@s.Subject?.SubjectName</span>
                            </td>
                            <td>
                                @if (s.Task != null)
                                {
                                    <span class="badge bg-secondary-subtle text-secondary">@s.Task.Title</span>
                                }
                                else
                                {
                                    <span class="text-muted small">&mdash;</span>
                                }
                            </td>
                            <td class="small text-muted">
                                @s.StartTime @(string.IsNullOrEmpty(s.EndTime) ? "" : $" - {s.EndTime}")
                            </td>
                            <td>
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle fs-6">
                                    @s.DurationMinutes min
                                </span>
                            </td>
                            <td>
                                <span class="badge @(s.Status == "Completed" ? "bg-success" : (s.Status == "In Progress" ? "bg-warning text-dark" : "bg-secondary")) rounded-pill">
                                    @s.Status
                                </span>
                            </td>
                            <td class="small text-muted" style="max-width: 200px;">
                                <div class="text-truncate" title="@s.Notes">
                                    @(string.IsNullOrEmpty(s.Notes) ? "-" : s.Notes)
                                </div>
                            </td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@s.StudySessionId" class="btn btn-sm btn-outline-secondary p-1" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@s.StudySessionId" method="post" class="d-inline" onsubmit="return confirm('Delete this study log entry?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger p-1" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center py-5 text-muted">
                            <i class="bi bi-clock-history fs-2 d-block mb-2"></i>
                            No study sessions logged yet.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

