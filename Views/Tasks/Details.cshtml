@model SmartStudyPlanner.Models.StudyTask
@{
    ViewData["Title"] = "Task Details";
    var daysLeft = (Model.Deadline.Date - DateTime.Today).Days;
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card card-custom p-4 shadow-sm mb-4">
            <div class="d-flex align-items-start justify-content-between mb-3 border-bottom pb-3">
                <div>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle me-2">@Model.Subject?.SubjectName</span>
                    <span class="badge bg-light text-secondary border">@Model.TaskType</span>
                    <h3 class="fw-bold mt-2 mb-1">@Model.Title</h3>
                    <div class="small text-muted">Created: @Model.CreatedAt.ToString("MMM dd, yyyy")</div>
                </div>
                <span class="badge @(Model.Status == "Completed" ? "bg-success" : (Model.Status == "In Progress" ? "bg-warning text-dark" : "bg-secondary")) px-3 py-2 fs-6 rounded-pill">
                    @Model.Status
                </span>
            </div>

            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <div class="mb-4">
                    <h6 class="fw-bold text-secondary text-uppercase small">Description / Notes</h6>
                    <p class="text-dark bg-light p-3 rounded-3 mb-0">@Model.Description</p>
                </div>
            }

            <div class="row g-3 mb-4">
                <div class="col-sm-6 col-md-3">
                    <div class="p-3 bg-light rounded-3 text-center border">
                        <small class="text-muted d-block mb-1">Deadline</small>
                        <strong class="d-block">@Model.Deadline.ToString("MMM dd, yyyy")</strong>
                        @if (Model.Status != "Completed")
                        {
                            <small class="@(daysLeft <= 2 ? "text-danger fw-bold" : "text-muted")">
                                @(daysLeft < 0 ? $"{Math.Abs(daysLeft)}d overdue" : (daysLeft == 0 ? "Due Today" : $"{daysLeft}d left"))
                            </small>
                        }
                    </div>
                </div>

                <div class="col-sm-6 col-md-3">
                    <div class="p-3 bg-light rounded-3 text-center border">
                        <small class="text-muted d-block mb-1">Priority</small>
                        <span class="badge @(Model.Priority == "Urgent" || Model.Priority == "High" ? "bg-danger" : "bg-primary") rounded-pill">
                            @Model.Priority
                        </span>
                        <small class="d-block text-muted mt-1">Diff: @Model.Difficulty</small>
                    </div>
                </div>

                <div class="col-sm-6 col-md-3">
                    <div class="p-3 bg-light rounded-3 text-center border">
                        <small class="text-muted d-block mb-1">Progress</small>
                        <h5 class="fw-bold mb-1 text-primary">@Model.ProgressPercentage%</h5>
                        <div class="progress" style="height: 6px;">
                            <div class="progress-bar bg-primary" role="progressbar" style="width: @Model.ProgressPercentage%"></div>
                        </div>
                    </div>
                </div>

                <div class="col-sm-6 col-md-3">
                    <div class="p-3 bg-light rounded-3 text-center border">
                        <small class="text-muted d-block mb-1">Hours Logged</small>
                        <h5 class="fw-bold mb-0 text-success">@Model.ActualHours h</h5>
                        <small class="text-muted">Target: @Model.EstimatedHours h</small>
                    </div>
                </div>
            </div>

            <!-- Linked Study Sessions for this task -->
            <h5 class="fw-bold mb-3 d-flex align-items-center justify-content-between">
                <span><i class="bi bi-clock-history me-2 text-primary"></i>Linked Study Sessions</span>
                <a asp-controller="StudySessions" asp-action="Create" asp-route-subjectId="@Model.SubjectId" asp-route-taskId="@Model.TaskId" class="btn btn-sm btn-outline-primary">
                    + Log Time on this Task
                </a>
            </h5>

            @if (Model.StudySessions.Any())
            {
                <div class="table-responsive mb-3">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>Date</th>
                                <th>Topic</th>
                                <th>Duration</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in Model.StudySessions)
                            {
                                <tr>
                                    <td>@s.StudyDate.ToString("MMM dd, yyyy")</td>
                                    <td>@s.Topic</td>
                                    <td>@s.DurationMinutes mins</td>
                                    <td><span class="badge bg-success-subtle text-success border border-success-subtle">@s.Status</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="p-3 bg-light rounded-3 text-center text-muted small mb-3">
                    No study sessions specifically linked to this task yet.
                </div>
            }

            <div class="d-flex justify-content-between pt-3 border-top">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Back to Tasks
                </a>
                <div class="d-flex gap-2">
                    <form asp-action="ToggleComplete" asp-route-id="@Model.TaskId" method="post" class="m-0">
                        <button type="submit" class="btn @(Model.Status == "Completed" ? "btn-outline-warning" : "btn-success")">
                            <i class="bi bi-check2 me-1"></i> @(Model.Status == "Completed" ? "Mark Incomplete" : "Mark as Completed")
                        </button>
                    </form>
                    <a asp-action="Edit" asp-route-id="@Model.TaskId" class="btn btn-primary-custom">
                        <i class="bi bi-pencil me-1"></i> Edit
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

