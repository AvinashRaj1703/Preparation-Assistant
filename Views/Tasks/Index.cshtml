@model IEnumerable<SmartStudyPlanner.Models.StudyTask>
@{
    ViewData["Title"] = "Tasks & Assignments";
}

<div class="page-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
    <div>
        <h2><i class="bi bi-check2-square text-primary me-2"></i>Tasks & Assignments</h2>
        <p class="text-secondary mb-0">Track homework, coding labs, research papers, and coursework deadlines.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary-custom">
        <i class="bi bi-plus-lg me-1"></i> Add New Task
    </a>
</div>

<!-- Filters & Search Bar -->
<div class="card card-custom p-3 mb-4">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-3">
            <input type="text" name="search" class="form-control" placeholder="Search tasks..." value="@ViewBag.SearchTerm" />
        </div>
        <div class="col-md-3">
            <select name="subjectId" class="form-select" asp-items="ViewBag.Subjects">
                <option value="">All Subjects</option>
            </select>
        </div>
        <div class="col-md-2">
            <select name="status" class="form-select">
                <option value="All" selected="@(ViewBag.SelectedStatus == "All" || string.IsNullOrEmpty(ViewBag.SelectedStatus))">All Statuses</option>
                <option value="Pending" selected="@(ViewBag.SelectedStatus == "Pending")">Pending</option>
                <option value="In Progress" selected="@(ViewBag.SelectedStatus == "In Progress")">In Progress</option>
                <option value="Completed" selected="@(ViewBag.SelectedStatus == "Completed")">Completed</option>
            </select>
        </div>
        <div class="col-md-2">
            <select name="priority" class="form-select">
                <option value="All" selected="@(ViewBag.SelectedPriority == "All" || string.IsNullOrEmpty(ViewBag.SelectedPriority))">All Priorities</option>
                <option value="Urgent" selected="@(ViewBag.SelectedPriority == "Urgent")">Urgent</option>
                <option value="High" selected="@(ViewBag.SelectedPriority == "High")">High</option>
                <option value="Medium" selected="@(ViewBag.SelectedPriority == "Medium")">Medium</option>
                <option value="Low" selected="@(ViewBag.SelectedPriority == "Low")">Low</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary w-100"><i class="bi bi-funnel me-1"></i> Filter</button>
            <a asp-action="Index" class="btn btn-outline-secondary" title="Reset Filters"><i class="bi bi-arrow-counterclockwise"></i></a>
        </div>
    </form>
</div>

<!-- Task Table -->
<div class="card card-custom overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light text-secondary small text-uppercase">
                <tr>
                    <th style="width: 40px;"></th>
                    <th>Task / Assignment</th>
                    <th>Subject</th>
                    <th>Type</th>
                    <th>Deadline</th>
                    <th>Priority</th>
                    <th>Difficulty</th>
                    <th style="width: 140px;">Progress</th>
                    <th>Est / Act Hrs</th>
                    <th class="text-end" style="width: 120px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        var isCompleted = item.Status == "Completed";
                        var daysLeft = (item.Deadline.Date - DateTime.Today).Days;
                        <tr class="@(isCompleted ? "table-light text-muted opacity-75" : "")">
                            <td>
                                <form asp-action="ToggleComplete" asp-route-id="@item.TaskId" method="post" class="m-0">
                                    <button type="submit" class="btn btn-sm @(isCompleted ? "btn-success" : "btn-outline-secondary") rounded-circle p-1 d-flex align-items-center justify-content-center" style="width: 26px; height: 26px;" title="Toggle Completion">
                                        <i class="bi bi-check"></i>
                                    </button>
                                </form>
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@item.TaskId" class="fw-bold text-decoration-none @(isCompleted ? "text-decoration-line-through text-muted" : "text-dark")">
                                    @item.Title
                                </a>
                                @if (!string.IsNullOrEmpty(item.Description))
                                {
                                    <div class="small text-muted text-truncate" style="max-width: 240px;">@item.Description</div>
                                }
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@item.Subject?.SubjectName</span>
                            </td>
                            <td>
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle">@item.TaskType</span>
                            </td>
                            <td>
                                <div>@item.Deadline.ToString("MMM dd, yyyy")</div>
                                @if (!isCompleted)
                                {
                                    @if (daysLeft < 0)
                                    {
                                        <span class="badge bg-danger">Overdue (@Math.Abs(daysLeft)d)</span>
                                    }
                                    else if (daysLeft == 0)
                                    {
                                        <span class="badge bg-warning text-dark">Due Today</span>
                                    }
                                    else if (daysLeft <= 3)
                                    {
                                        <span class="badge bg-warning text-dark">@daysLeft days left</span>
                                    }
                                }
                            </td>
                            <td>
                                @if (item.Priority == "Urgent")
                                {
                                    <span class="badge bg-danger">Urgent</span>
                                }
                                else if (item.Priority == "High")
                                {
                                    <span class="badge bg-warning text-dark">High</span>
                                }
                                else if (item.Priority == "Medium")
                                {
                                    <span class="badge bg-info text-dark">Medium</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Low</span>
                                }
                            </td>
                            <td>
                                <span class="badge bg-light text-secondary border">@item.Difficulty</span>
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="progress flex-grow-1" style="height: 6px;">
                                        <div class="progress-bar @(isCompleted ? "bg-success" : "bg-primary")" role="progressbar" style="width: @item.ProgressPercentage%"></div>
                                    </div>
                                    <small class="fw-semibold">@item.ProgressPercentage%</small>
                                </div>
                            </td>
                            <td class="small">
                                <span class="text-secondary">@item.EstimatedHours h est.</span><br />
                                <span class="fw-semibold text-dark">@item.ActualHours h act.</span>
                            </td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@item.TaskId" class="btn btn-sm btn-outline-secondary p-1" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@item.TaskId" method="post" class="d-inline" onsubmit="return confirm('Delete this task?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger p-1" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="10" class="text-center py-5 text-muted">
                            <i class="bi bi-clipboard-check fs-2 d-block mb-2"></i>
                            No tasks found matching your criteria.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

