@model SmartStudyPlanner.Models.RevisionPlan
@{
    ViewData["Title"] = "Edit Revision Plan";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card card-custom p-4 shadow-sm">
            <h4 class="fw-bold mb-3"><i class="bi bi-pencil-square text-primary me-2"></i>Edit Revision Plan</h4>

            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="RevisionPlanId" />
                <input type="hidden" asp-for="UserId" />
                <input type="hidden" asp-for="CreatedAt" />

                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="SubjectId" class="form-label fw-semibold"></label>
                        <select asp-for="SubjectId" class="form-select" asp-items="ViewBag.SubjectId"></select>
                        <span asp-validation-for="SubjectId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ExamId" class="form-label fw-semibold"></label>
                        <select asp-for="ExamId" class="form-select" asp-items="ViewBag.ExamId">
                            <option value="">-- None (General Revision) --</option>
                        </select>
                        <span asp-validation-for="ExamId" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Topic" class="form-label fw-semibold"></label>
                        <input asp-for="Topic" class="form-control" />
                        <span asp-validation-for="Topic" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="RevisionDate" class="form-label fw-semibold"></label>
                        <input asp-for="RevisionDate" type="date" class="form-control" />
                        <span asp-validation-for="RevisionDate" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="StartTime" class="form-label fw-semibold"></label>
                        <input asp-for="StartTime" type="time" class="form-control" />
                        <span asp-validation-for="StartTime" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="DurationMinutes" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <input asp-for="DurationMinutes" type="number" min="10" max="360" step="5" class="form-control" />
                            <span class="input-group-text">mins</span>
                        </div>
                        <span asp-validation-for="DurationMinutes" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Status" class="form-label fw-semibold"></label>
                        <select asp-for="Status" class="form-select">
                            <option value="Scheduled">Scheduled</option>
                            <option value="Completed">Completed</option>
                            <option value="Skipped">Skipped</option>
                        </select>
                        <span asp-validation-for="Status" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Notes" class="form-label fw-semibold"></label>
                        <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Notes" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-between mt-4 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary-custom">Update Revision Plan</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

