@{
    ViewData["Title"] = "MongoDB Cloud Database";
    bool isConnected = ViewBag.IsConnected == true;
    var counts = ViewBag.CollectionCounts as Dictionary<string, long> ?? new();
}

<div class="page-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
    <div>
        <h2><i class="bi bi-cloud-check-fill text-success me-2"></i>MongoDB Atlas Cloud Database</h2>
        <p class="text-secondary mb-0">Connected live to your MongoDB Atlas cluster for cloud storage, backups, and NoSQL synchronization.</p>
    </div>
    @if (isConnected)
    {
        <form asp-action="SyncToMongo" method="post" class="m-0">
            <button type="submit" class="btn btn-success fw-bold px-3 py-2 shadow-sm">
                <i class="bi bi-arrow-repeat me-1"></i> Sync All Data to MongoDB
            </button>
        </form>
    }
</div>

<!-- Connection Status Card -->
<div class="row g-4 mb-4">
    <div class="col-lg-7">
        <div class="card card-custom p-4 h-100">
            <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-3">
                <div class="d-flex align-items-center gap-2">
                    <span class="p-2 bg-success-subtle text-success rounded-3 d-inline-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                        <i class="bi bi-hdd-network-fill fs-5"></i>
                    </span>
                    <div>
                        <h5 class="fw-bold mb-0">Cluster Connection Status</h5>
                        <small class="text-muted">MongoDB Atlas Serverless / Sharded Cluster</small>
                    </div>
                </div>
                @if (isConnected)
                {
                    <span class="badge bg-success px-3 py-2 rounded-pill fs-6">
                        <i class="bi bi-check-circle me-1"></i> Connected (@(ViewBag.LatencyMs)ms)
                    </span>
                }
                else
                {
                    <span class="badge bg-danger px-3 py-2 rounded-pill fs-6">
                        <i class="bi bi-x-circle me-1"></i> Disconnected
                    </span>
                }
            </div>

            <div class="bg-light p-3 rounded-3 mb-3 small font-monospace">
                <div class="text-muted mb-1">// Connection String (Configured in appsettings.json)</div>
                <div class="fw-bold text-dark text-break">@ViewBag.MaskedMongoUri</div>
            </div>

            <table class="table table-sm table-bordered small mb-0">
                <tr>
                    <th class="bg-light w-35">Target Database</th>
                    <td><strong class="text-primary">@ViewBag.MongoDbName</strong></td>
                </tr>
                <tr>
                    <th class="bg-light">Health Ping Message</th>
                    <td>
                        <span class="@(isConnected ? "text-success fw-semibold" : "text-danger")">
                            @ViewBag.PingMessage
                        </span>
                    </td>
                </tr>
                <tr>
                    <th class="bg-light">Cluster Node Type</th>
                    <td>MongoDB Atlas Replica Set (AWS/GCP cloud)</td>
                </tr>
                <tr>
                    <th class="bg-light">Driver Library</th>
                    <td><code>MongoDB.Driver 3.13.0</code> (.NET 8 official driver)</td>
                </tr>
            </table>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card card-custom p-4 h-100 bg-gradient border-success-subtle">
            <div class="d-flex align-items-center gap-2 mb-3">
                <i class="bi bi-layers-fill text-success fs-4"></i>
                <h5 class="fw-bold mb-0">Multi-Database Architecture</h5>
            </div>
            <p class="text-secondary small mb-3">
                Your application now implements a professional <strong>Hybrid Polyglot Persistence Architecture</strong>:
            </p>
            <ul class="list-unstyled small text-muted d-flex flex-column gap-2 mb-4">
                <li class="d-flex align-items-start gap-2">
                    <i class="bi bi-check2-circle text-primary fs-6 mt-0.5"></i>
                    <div><strong>Relational Core (EF Core)</strong>: Primary transactional engine for ACID operations, complex joins, and razor views.</div>
                </li>
                <li class="d-flex align-items-start gap-2">
                    <i class="bi bi-check2-circle text-success fs-6 mt-0.5"></i>
                    <div><strong>NoSQL Cloud (MongoDB Atlas)</strong>: Distributed cloud backup, document-oriented storage, and JSON API analytics.</div>
                </li>
            </ul>

            <div class="mt-auto">
                <form asp-action="SyncToMongo" method="post" class="m-0">
                    <button type="submit" class="btn btn-outline-success w-100 py-2 fw-semibold">
                        <i class="bi bi-cloud-arrow-up-fill me-1"></i> Push All Collections to Atlas
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Collections Grid -->
<div class="card card-custom overflow-hidden mb-4">
    <div class="p-3 bg-light border-bottom d-flex align-items-center justify-content-between">
        <h5 class="fw-bold mb-0"><i class="bi bi-collection-fill text-primary me-2"></i>Schema Modules & Cloud Collections</h5>
        <span class="badge bg-secondary-subtle text-secondary border">8 Collections</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small text-uppercase text-secondary">
                <tr>
                    <th>Module / Entity</th>
                    <th>MongoDB Collection</th>
                    <th>Local Relational Records</th>
                    <th>MongoDB Atlas Documents</th>
                    <th>Sync Status</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="fw-bold"><i class="bi bi-person me-2 text-primary"></i>Users</td>
                    <td><code>users</code></td>
                    <td>@ViewBag.LocalUsersCount rows</td>
                    <td><strong class="text-success">@(counts.GetValueOrDefault("users", 0))</strong> docs</td>
                    <td><span class="badge bg-success-subtle text-success border border-success-subtle">Ready</span></td>
                </tr>
                <tr>
                    <td class="fw-bold"><i class="bi bi-journal-bookmark me-2 text-primary"></i>Subjects</td>
                    <td><code>subjects</code></td>
                    <td>@ViewBag.LocalSubjectsCount rows</td>
                    <td><strong class="text-success">@(counts.GetValueOrDefault("subjects", 0))</strong> docs</td>
                    <td><span class="badge bg-success-subtle text-success border border-success-subtle">Ready</span></td>
                </tr>
                <tr>
                    <td class="fw-bold"><i class="bi bi-check2-square me-2 text-warning"></i>Tasks & Assignments</td>
                    <td><code>tasks</code></td>
                    <td>@ViewBag.LocalTasksCount rows</td>
                    <td><strong class="text-success">@(counts.GetValueOrDefault("tasks", 0))</strong> docs</td>
                    <td><span class="badge bg-success-subtle text-success border border-success-subtle">Ready</span></td>
                </tr>
                <tr>
                    <td class="fw-bold"><i class="bi bi-award me-2 text-danger"></i>Exams</td>
                    <td><code>exams</code></td>
                    <td>@ViewBag.LocalExamsCount rows</td>
                    <td><strong class="text-success">@(counts.GetValueOrDefault("exams", 0))</strong> docs</td>
                    <td><span class="badge bg-success-subtle text-success border border-success-subtle">Ready</span></td>
                </tr>
                <tr>
                    <td class="fw-bold"><i class="bi bi-clock-history me-2 text-primary"></i>Study Sessions</td>
                    <td><code>studysessions</code></td>
                    <td>@ViewBag.LocalSessionsCount rows</td>
                    <td><strong class="text-success">@(counts.GetValueOrDefault("studysessions", 0))</strong> docs</td>
                    <td><span class="badge bg-success-subtle text-success border border-success-subtle">Ready</span></td>
                </tr>
                <tr>
                    <td class="fw-bold"><i class="bi bi-arrow-repeat me-2 text-purple" style="color: #8b5cf6;"></i>Revision Plans</td>
                    <td><code>revisionplans</code></td>
                    <td>@ViewBag.LocalRevisionsCount rows</td>
                    <td><strong class="text-success">@(counts.GetValueOrDefault("revisionplans", 0))</strong> docs</td>
                    <td><span class="badge bg-success-subtle text-success border border-success-subtle">Ready</span></td>
                </tr>
                <tr>
                    <td class="fw-bold"><i class="bi bi-bullseye me-2 text-info"></i>Daily Goals</td>
                    <td><code>dailygoals</code></td>
                    <td>@ViewBag.LocalGoalsCount rows</td>
                    <td><strong class="text-success">@(counts.GetValueOrDefault("dailygoals", 0))</strong> docs</td>
                    <td><span class="badge bg-success-subtle text-success border border-success-subtle">Ready</span></td>
                </tr>
                <tr>
                    <td class="fw-bold"><i class="bi bi-bell me-2 text-danger"></i>Notifications</td>
                    <td><code>notifications</code></td>
                    <td>@ViewBag.LocalNotifsCount rows</td>
                    <td><strong class="text-success">@(counts.GetValueOrDefault("notifications", 0))</strong> docs</td>
                    <td><span class="badge bg-success-subtle text-success border border-success-subtle">Ready</span></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
