@using System.Security.Claims
@inject SmartStudyPlanner.Services.INotificationService NotificationService

@{
    int unreadCount = 0;
    if (User.Identity?.IsAuthenticated == true)
    {
        var claim = User.FindFirst(ClaimTypes.NameIdentifier);
        if (claim != null && int.TryParse(claim.Value, out int uid))
        {
            unreadCount = await NotificationService.GetUnreadCountAsync(uid);
        }
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Smart Study Planner</title>
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 & Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- Custom styling -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        body {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: #f8fafc;
            color: #1e293b;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .navbar-custom {
            background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%);
            box-shadow: 0 4px 20px -2px rgba(30, 58, 138, 0.25);
        }

        .navbar-custom .navbar-brand {
            font-weight: 800;
            letter-spacing: -0.5px;
            color: #ffffff !important;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .navbar-custom .nav-link {
            color: rgba(255, 255, 255, 0.85) !important;
            font-weight: 500;
            padding: 0.5rem 0.85rem !important;
            border-radius: 8px;
            transition: all 0.2s ease;
        }

        .navbar-custom .nav-link:hover,
        .navbar-custom .nav-link.active {
            color: #ffffff !important;
            background: rgba(255, 255, 255, 0.15);
        }

        .badge-notification {
            position: absolute;
            top: -4px;
            right: -6px;
            font-size: 0.65rem;
            padding: 0.25em 0.5em;
        }

        .card-custom {
            border: 1px solid #e2e8f0;
            border-radius: 14px;
            background: #ffffff;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -2px rgba(0, 0, 0, 0.05);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .card-custom:hover {
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.08), 0 4px 6px -4px rgba(0, 0, 0, 0.05);
        }

        .stat-icon-box {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.4rem;
        }

        .page-header {
            margin-bottom: 1.5rem;
        }
        .page-header h2 {
            font-weight: 800;
            letter-spacing: -0.5px;
            color: #0f172a;
        }

        .btn-primary-custom {
            background-color: #2563eb;
            border-color: #2563eb;
            color: #ffffff;
            font-weight: 600;
            border-radius: 8px;
            padding: 0.5rem 1.15rem;
            transition: all 0.2s ease;
        }
        .btn-primary-custom:hover {
            background-color: #1d4ed8;
            border-color: #1d4ed8;
            color: #ffffff;
            transform: translateY(-1px);
        }

        footer {
            margin-top: auto;
            background: #ffffff;
            border-top: 1px solid #e2e8f0;
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-custom py-2">
            <div class="container-fluid px-lg-4">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <span class="p-2 bg-white text-primary rounded-3 d-inline-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                        <i class="bi bi-mortarboard-fill fs-5"></i>
                    </span>
                    <span>Smart Study Planner</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavbar">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3 gap-1">
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Dashboard" asp-action="Index">
                                    <i class="bi bi-speedometer2 me-1"></i> Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Subjects" asp-action="Index">
                                    <i class="bi bi-journal-bookmark me-1"></i> Subjects
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Tasks" asp-action="Index">
                                    <i class="bi bi-check2-square me-1"></i> Tasks
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Exams" asp-action="Index">
                                    <i class="bi bi-award me-1"></i> Exams
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="StudySessions" asp-action="Index">
                                    <i class="bi bi-clock-history me-1"></i> Study Sessions
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="RevisionPlans" asp-action="Index">
                                    <i class="bi bi-arrow-repeat me-1"></i> Revision
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="DailyGoals" asp-action="Index">
                                    <i class="bi bi-bullseye me-1"></i> Daily Goals
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Calendar" asp-action="Index">
                                    <i class="bi bi-calendar3 me-1"></i> Calendar
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="DatabaseStatus" asp-action="Index">
                                    <i class="bi bi-cloud-check-fill text-info me-1"></i> Cloud DB
                                </a>
                            </li>
                        </ul>

                        <ul class="navbar-nav ms-auto align-items-center gap-2">
                            <!-- Notifications Bell -->
                            <li class="nav-item position-relative me-2">
                                <a class="nav-link p-2" asp-controller="Notifications" asp-action="Index" title="Notifications">
                                    <i class="bi bi-bell-fill fs-5"></i>
                                    @if (unreadCount > 0)
                                    {
                                        <span class="badge rounded-pill bg-danger badge-notification animate__animated animate__pulse animate__infinite">
                                            @unreadCount
                                        </span>
                                    }
                                </a>
                            </li>

                            <!-- User Menu -->
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center gap-2 text-white" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span class="rounded-circle bg-white text-primary d-inline-flex align-items-center justify-content-center fw-bold" style="width: 32px; height: 32px; font-size: 0.85rem;">
                                        @(User.Identity.Name?.Substring(0, 1).ToUpper() ?? "U")
                                    </span>
                                    <span class="d-none d-sm-inline fw-semibold">@User.Identity.Name</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0" aria-labelledby="userDropdown">
                                    <li><h6 class="dropdown-header text-muted">Logged in as @User.Identity.Name</h6></li>
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile"><i class="bi bi-person me-2"></i>My Profile</a></li>
                                    <li><a class="dropdown-item" asp-controller="DailyGoals" asp-action="CreateOrEditToday"><i class="bi bi-bullseye me-2"></i>Today's Goal</a></li>
                                    <li><a class="dropdown-item" asp-controller="DatabaseStatus" asp-action="Index"><i class="bi bi-cloud-check me-2 text-success"></i>Cloud DB (MongoDB)</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                            <button type="submit" class="dropdown-item text-danger">
                                                <i class="bi bi-box-arrow-right me-2"></i>Sign Out
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        </ul>
                    }
                    else
                    {
                        <ul class="navbar-nav ms-auto align-items-center gap-2">
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-light text-primary fw-bold px-3 py-1 rounded-pill" asp-controller="Account" asp-action="Register">
                                    Get Started Free
                                </a>
                            </li>
                        </ul>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid px-lg-4 py-4 flex-grow-1">
        <!-- Toast / Alerts -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 d-flex align-items-center" role="alert">
                <i class="bi bi-check-circle-fill fs-5 me-2 text-success"></i>
                <div>@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 d-flex align-items-center" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-5 me-2 text-danger"></i>
                <div>@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="py-3 text-muted">
        <div class="container-fluid px-lg-4 d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
            <div>
                <strong>Smart Study Planner</strong> &copy; 2026 &bull; Dotnet Course Project
            </div>
            <div class="small text-secondary">
                ASP.NET Core 8.0 &bull; Entity Framework Core &bull; Bootstrap 5 &bull; Chart.js
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
