@model SmartStudyPlanner.Models.Exam
@{
    ViewData["Title"] = "Exam Details - " + Model.ExamName;
    var daysLeft = (Model.ExamDate.Date - DateTime.Today).Days;
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card card-custom p-4 shadow-sm mb-4">
            <div class="d-flex align-items-start justify-content-between mb-3 border-bottom pb-3">
                <div>
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle me-2">@Model.Subject?.SubjectName</span>
                    <h3 class="fw-bold mt-2 mb-1">@Model.ExamName</h3>
                    <div class="small text-muted"><i class="bi bi-clock me-1"></i>Time Slot: @Model.ExamTime</div>
                </div>
                <div class="text-end">
                    <span class="badge @(daysLeft <= 7 ? "bg-danger" : "bg-dark") px-3 py-2 fs-6 rounded-pill">
                        @(daysLeft < 0 ? "Completed" : (daysLeft == 0 ? "TODAY" : $"{daysLeft} Days Remaining"))
                    </span>
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-sm-4">
                    <div class="p-3 bg-light rounded-3 text-center border">
                        <small class="text-muted d-block mb-1">Exam Date</small>
                        <strong class="d-block text-dark">@Model.ExamDate.ToString("dddd")</strong>
                        <div class="fw-bold text-danger">@Model.ExamDate.ToString("MMM dd, yyyy")</div>
                    </div>
                </div>

                <div class="col-sm-4">
                    <div class="p-3 bg-light rounded-3 text-center border">
                        <small class="text-muted d-block mb-1">Total Marks</small>
                        <h4 class="fw-bold mb-0 text-dark">@Model.TotalMarks</h4>
                        <small class="text-muted">Maximum score</small>
                    </div>
                </div>

                <div class="col-sm-4">
                    <div class="p-3 bg-light rounded-3 text-center border">
                        <small class="text-muted d-block mb-1">Passing Marks</small>
                        <h4 class="fw-bold mb-0 text-success">@Model.PassingMarks</h4>
                        <small class="text-muted">Pass criterion: @Math.Round((double)Model.PassingMarks / Model.TotalMarks * 100)%</small>
                    </div>
                </div>
            </div>

            <!-- Syllabus Section -->
            <div class="mb-4">
                <h5 class="fw-bold text-dark mb-2"><i class="bi bi-file-earmark-text text-primary me-2"></i>Syllabus & Topics</h5>
                <div class="bg-light p-3 rounded-3 border text-dark" style="white-space: pre-wrap;">
                    @(string.IsNullOrWhiteSpace(Model.Syllabus) ? "No syllabus entered yet." : Model.Syllabus)
                </div>
            </div>

            <!-- Linked Revision Plans -->
            <div class="mb-4">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <h5 class="fw-bold text-dark mb-0"><i class="bi bi-arrow-repeat text-purple me-2"></i>Scheduled Revision Topics</h5>
                    <a asp-controller="RevisionPlans" asp-action="Create" asp-route-examId="@Model.ExamId" asp-route-subjectId="@Model.SubjectId" class="btn btn-sm btn-outline-primary">
                        + Schedule Revision for this Exam
                    </a>
                </div>

                @if (Model.RevisionPlans.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-light small">
                                <tr>
                                    <th>Revision Date</th>
                                    <th>Topic</th>
                                    <th>Duration</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in Model.RevisionPlans)
                                {
                                    <tr>
                                        <td>@r.RevisionDate.ToString("MMM dd, yyyy")</td>
                                        <td class="fw-semibold">@r.Topic</td>
                                        <td>@r.DurationMinutes mins</td>
                                        <td>
                                            <span class="badge @(r.Status == "Completed" ? "bg-success" : "bg-primary") rounded-pill">
                                                @r.Status
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="p-3 bg-light rounded-3 text-center text-muted small">
                        No revision topics planned specifically for this exam yet.
                    </div>
                }
            </div>

            <div class="d-flex justify-content-between pt-3 border-top">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Back to Exams
                </a>
                <div class="d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.ExamId" class="btn btn-outline-primary">
                        <i class="bi bi-pencil me-1"></i> Edit
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

